# ─── Supabase ──────────────────────────────────────────────────────────────────
# Copie ce fichier en .env.local et remplis tes valeurs Supabase.
# Ne JAMAIS committer .env.local dans git.

NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# La service_role key n'est pas nécessaire pour ce MVP (RLS désactivé).
# Si tu actives RLS, utilise-la uniquement côté serveur (sans NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
